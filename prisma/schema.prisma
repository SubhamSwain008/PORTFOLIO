datasource db {
  provider  = "postgresql"
  url       = env("neon_db")
  directUrl = env("neon_db_direct")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  otp         String?
  otp_expires DateTime? @db.Timestamptz
  created_at  DateTime  @default(now()) @db.Timestamptz

  gameState   UserGameState?

  @@map("users")
}

model UserGameState {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory   Json     @default("[]")
  positionX   Float    @default(0)
  positionY   Float    @default(1.3)
  positionZ   Float    @default(8)
  currentWorld String  @default("night")
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@map("user_game_state")
}